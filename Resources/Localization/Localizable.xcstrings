    "Sửa nguồn" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Edit server"}}, "vi" : {"stringUnit" : {"state" : "translated", "value" : "Sửa nguồn"}}}},
    "The checker reads the IPA Info.plist, executable architecture, and ZIP CRCs. It does not install or decrypt the app." : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The checker reads the IPA Info.plist, executable architecture, and ZIP CRCs. It does not install or decrypt the app."}}, "vi" : {"stringUnit" : {"state" : "translated", "value" : "Trình kiểm tra đọc Info.plist, kiến trúc tệp thực thi và CRC của ZIP trong IPA. Nó không cài đặt hoặc giải mã ứng dụng."}}}},
    "The saved Anisette identity and this server's approval will be deleted from this device." : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The saved Anisette identity and this server's approval will be deleted from this device."}}, "vi" : {"stringUnit" : {"state" : "translated", "value" : "Danh tính Anisette đã lưu và quyền cho phép máy chủ này sẽ bị xóa khỏi thiết bị."}}}},
    "The selected server will receive a persistent Anisette identifier and adi_pb provisioning data over HTTPS. During provisioning, the app also sends some Apple provisioning exchange values through this server; its operator can read and retain the values it receives. Your Apple ID password and 2FA code are not sent to the Anisette Server." : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "The selected server will receive a persistent Anisette identifier and adi_pb provisioning data over HTTPS. During provisioning, the app also sends some Apple provisioning exchange values through this server; its operator can read and retain the values it receives. Your Apple ID password and 2FA code are not sent to the Anisette Server."}}, "vi" : {"stringUnit" : {"state" : "translated", "value" : "Máy chủ được chọn sẽ nhận identifier Anisette dùng lâu dài và dữ liệu cấp phát adi_pb qua HTTPS. Trong quá trình cấp phát, ứng dụng còn gửi một số dữ liệu trao đổi với Apple qua máy chủ này; người vận hành có thể đọc và lưu những giá trị máy chủ nhận được. Mật khẩu Apple ID và mã 2FA không được gửi đến Anisette Server."}}}},
    "These are values from the device running IPAForge. They are separate from the compatibility profile below." : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "These are values from the device running IPAForge. They are separate from the compatibility profile below."}}, "vi" : {"stringUnit" : {"state" : "translated", "value" : "Đây là thông tin của thiết bị đang chạy IPAForge, tách biệt với hồ sơ tương thích bên dưới."}}}},
    "This device" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "This device"}}, "vi" : {"stringUnit" : {"state" : "translated", "value" : "Thiết bị này"}}}},
    "This profile is only input to compatibility checks. It does not create an Xcode Simulator, change the real device, or provide an Apple Device Identity." : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "This profile is only input to compatibility checks. It does not create an Xcode Simulator, change the real device, or provide an Apple Device Identity."}}, "vi" : {"stringUnit" : {"state" : "translated", "value" : "Hồ sơ này chỉ dùng làm đầu vào cho kiểm tra tương thích. Nó không tạo Xcode Simulator, thay đổi thiết bị thật hoặc cung cấp Apple Device Identity."}}}},
    "This simulated profile checks only Minimum OS. It does not verify real-device compatibility or enable IPA downloads." : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "This simulated profile checks only Minimum OS. It does not verify real-device compatibility or enable IPA downloads."}}, "vi" : {"stringUnit" : {"state" : "translated", "value" : "Hồ sơ mô phỏng này chỉ kiểm tra iOS tối thiểu. Hồ sơ không xác minh khả năng tương thích với thiết bị thật và không cho phép tải IPA."}}}},
    "Thêm nguồn mới" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Add a server"}}, "vi" : {"stringUnit" : {"state" : "translated", "value" : "Thêm máy chủ"}}}},
    "Verification code" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Verification code"}}, "vi" : {"stringUnit" : {"state" : "translated", "value" : "Mã xác minh"}}}},
    "Verifying IPA structure and integrity…" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Verifying IPA structure and integrity…"}}, "vi" : {"stringUnit" : {"state" : "translated", "value" : "Đang kiểm tra cấu trúc và tính toàn vẹn của IPA…"}}}},
    "Version %@ • iOS %@" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Version %@ • iOS %@"}}, "vi" : {"stringUnit" : {"state" : "translated", "value" : "Phiên bản %@ • iOS %@"}}}},
    "Vui lòng nhập Apple ID và mật khẩu, không để trống ô nào." : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Please enter your Apple ID and password."}}, "vi" : {"stringUnit" : {"state" : "translated", "value" : "Vui lòng nhập Apple ID và mật khẩu, không để trống ô nào."}}}},
    "Waiting for verification…" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Waiting for verification…"}}, "vi" : {"stringUnit" : {"state" : "translated", "value" : "Đang chờ xác minh…"}}}},
    "Waiting to download…" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Waiting to download…"}}, "vi" : {"stringUnit" : {"state" : "translated", "value" : "Đang chờ tải xuống…"}}}},
