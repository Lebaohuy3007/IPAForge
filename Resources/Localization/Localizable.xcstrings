    "%@ downloaded · total unknown" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "%@ downloaded · total unknown"}}, "vi" : {"stringUnit" : {"state" : "translated", "value" : "Đã tải %@ · chưa xác định tổng dung lượng"}}}},
