    "Xóa nguồn Anisette?" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "Delete Anisette server?"}}, "vi" : {"stringUnit" : {"state" : "translated", "value" : "Xóa nguồn Anisette?"}}}},
